<svg>
  <rect id="background" x="0" y="0" width="100%" height="100%" fill="#000000" />

  <!-- Top header bar (back to lists, status, manual sync trigger) -->
  <rect id="header-bg" x="0" y="0" width="100%" height="38" fill="#111827" />
  <rect id="back-btn" x="6" y="5" width="54" height="28" rx="6" fill="#374151" pointer-events="visible" display="none" />
  <text id="back-btn-label" x="33" y="24" text-anchor="middle" font-size="14" fill="#ffffff" pointer-events="none" display="none">Lists</text>
  <text id="status" x="66" y="25" text-length="32" font-size="16" fill="#e5e7eb">Loading...</text>
  <rect id="sync-btn" x="236" y="5" width="58" height="28" rx="6" fill="#2563eb" pointer-events="visible" />
  <text id="sync-btn-label" x="265" y="24" text-anchor="middle" font-size="14" fill="#ffffff" pointer-events="none">Sync</text>
  <rect id="header-divider" x="0" y="38" width="100%" height="2" fill="#1f2937" />

  <!-- Reusable list picker tile -->
  <symbol id="list-item">
    <use id="list-tile-list" href="#tile-list-item" class="tile-list-item">
      <rect id="list-touch" x="0" y="0" width="100%" height="58" fill="#000000" pointer-events="visible" />
      <text id="list-title" x="14" y="28" text-length="28" font-size="22" fill="#ffffff" pointer-events="none"></text>
      <text id="list-subtitle" x="14" y="50" text-length="28" font-size="14" fill="#60a5fa" pointer-events="none"></text>
      <rect id="list-divider-bottom" y="56" width="100%" height="2" fill="#1f2937" />
    </use>
  </symbol>

  <!-- Reusable task tile -->
  <symbol id="task-item">
    <use id="task-tile-list" href="#tile-list-item" class="tile-list-item">
      <rect id="item-background" height="58" fill="#000000" />

      <use id="task-checkbox" href="#checkbox-tile" class="checkbox-tile">
        <set id="summary" href="header/text" attributeName="text-buffer" to="Placeholder" />
      </use>
      <text id="item-category" x="14" y="52" text-length="32" font-size="14" fill="#60a5fa" pointer-events="none"></text>

      <rect id="tile-divider-bottom" y="56" width="100%" height="2" fill="#1f2937" />
    </use>
  </symbol>

  <!-- View 1: Available task lists -->
  <g id="lists-view">
    <use id="lists-checklist" href="#tile-list" x="0" y="40" width="100%" height="260">
      <use id="list-item-0" href="#list-item" class="item" />
      <use id="list-item-1" href="#list-item" class="item" />
      <use id="list-item-2" href="#list-item" class="item" />
      <use id="list-item-3" href="#list-item" class="item" />
      <use id="list-item-4" href="#list-item" class="item" />
      <use id="list-item-5" href="#list-item" class="item" />
      <use id="list-item-6" href="#list-item" class="item" />
      <use id="list-item-7" href="#list-item" class="item" />
      <use id="list-item-8" href="#list-item" class="item" />
      <use id="list-item-9" href="#list-item" class="item" />
      <use id="list-item-10" href="#list-item" class="item" />
      <use id="list-item-11" href="#list-item" class="item" />
      <use id="list-item-12" href="#list-item" class="item" />
      <use id="list-item-13" href="#list-item" class="item" />
      <use id="list-item-14" href="#list-item" class="item" />
      <use id="list-item-15" href="#list-item" class="item" />
      <use id="list-item-16" href="#list-item" class="item" />
      <use id="list-item-17" href="#list-item" class="item" />
      <use id="list-item-18" href="#list-item" class="item" />
      <use id="list-item-19" href="#list-item" class="item" />
    </use>
  </g>

  <!-- View 2: Selected task list items -->
  <g id="tasks-view" display="none">
    <use id="checklist" href="#tile-list" x="0" y="40" width="100%" height="260">
      <use id="item-0" href="#task-item" class="item" />
      <use id="item-1" href="#task-item" class="item" />
      <use id="item-2" href="#task-item" class="item" />
      <use id="item-3" href="#task-item" class="item" />
      <use id="item-4" href="#task-item" class="item" />
      <use id="item-5" href="#task-item" class="item" />
      <use id="item-6" href="#task-item" class="item" />
      <use id="item-7" href="#task-item" class="item" />
      <use id="item-8" href="#task-item" class="item" />
      <use id="item-9" href="#task-item" class="item" />
      <use id="item-10" href="#task-item" class="item" />
      <use id="item-11" href="#task-item" class="item" />
      <use id="item-12" href="#task-item" class="item" />
      <use id="item-13" href="#task-item" class="item" />
      <use id="item-14" href="#task-item" class="item" />
      <use id="item-15" href="#task-item" class="item" />
      <use id="item-16" href="#task-item" class="item" />
      <use id="item-17" href="#task-item" class="item" />
      <use id="item-18" href="#task-item" class="item" />
      <use id="item-19" href="#task-item" class="item" />
      <use id="item-20" href="#task-item" class="item" />
      <use id="item-21" href="#task-item" class="item" />
      <use id="item-22" href="#task-item" class="item" />
      <use id="item-23" href="#task-item" class="item" />
      <use id="item-24" href="#task-item" class="item" />
      <use id="item-25" href="#task-item" class="item" />
      <use id="item-26" href="#task-item" class="item" />
      <use id="item-27" href="#task-item" class="item" />
      <use id="item-28" href="#task-item" class="item" />
      <use id="item-29" href="#task-item" class="item" />
      <use id="item-30" href="#task-item" class="item" />
      <use id="item-31" href="#task-item" class="item" />
      <use id="item-32" href="#task-item" class="item" />
      <use id="item-33" href="#task-item" class="item" />
      <use id="item-34" href="#task-item" class="item" />
      <use id="item-35" href="#task-item" class="item" />
      <use id="item-36" href="#task-item" class="item" />
      <use id="item-37" href="#task-item" class="item" />
      <use id="item-38" href="#task-item" class="item" />
      <use id="item-39" href="#task-item" class="item" />
      <use id="item-40" href="#task-item" class="item" />
      <use id="item-41" href="#task-item" class="item" />
      <use id="item-42" href="#task-item" class="item" />
      <use id="item-43" href="#task-item" class="item" />
      <use id="item-44" href="#task-item" class="item" />
      <use id="item-45" href="#task-item" class="item" />
      <use id="item-46" href="#task-item" class="item" />
      <use id="item-47" href="#task-item" class="item" />
      <use id="item-48" href="#task-item" class="item" />
      <use id="item-49" href="#task-item" class="item" />
    </use>
  </g>
</svg>
