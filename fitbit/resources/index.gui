<svg>
  <defs>
    <!-- Row 0 (52px): top 28px clears the sticky status bar; bottom 24px shows the active list name when pulled down -->
    <symbol id="top-spacer" height="52">
      <use id="spacer-tile-list" href="#tile-list-item" class="task-list-tile" height="52" display="inline">
        <rect x="0" y="0" width="100%" height="52" fill="#000000" pointer-events="none" />
        <text id="active-list-label" x="150" y="46" text-anchor="middle" text-length="24" font-size="16" fill="#9ca3af" pointer-events="none"></text>
      </use>
    </symbol>

    <!-- Row 1 (52px): pull-down split action bar with Sync (left) and Autohide/Show All (right) -->
    <symbol id="actions-tile" height="52">
      <use id="actions-tile-list" href="#tile-list-item" class="task-list-tile" height="52" display="inline">
        <rect x="0" y="0" width="100%" height="52" fill="#000000" pointer-events="none" />
        <rect id="sync-touch" x="8" y="4" width="138" height="44" rx="10" fill="#2563eb" pointer-events="visible" />
        <text id="sync-label" x="77" y="33" text-anchor="middle" text-length="14" font-size="20" fill="#ffffff" pointer-events="none">Sync</text>
        <rect id="autohide-touch" x="154" y="4" width="138" height="44" rx="10" fill="#374151" pointer-events="visible" />
        <text id="autohide-label" x="223" y="33" text-anchor="middle" text-length="14" font-size="20" fill="#ffffff" pointer-events="none">Autohide</text>
      </use>
    </symbol>

    <!-- Static task/category row tile (52px): toggles between category-group and task-group cleanly without VirtualTileList scroll-up bugs -->
    <symbol id="list-row" height="52">
      <use id="row-tile-list" href="#tile-list-item" class="task-list-tile" height="52" display="none">
        <g id="category-group" display="none" pointer-events="none">
          <rect x="0" y="0" width="100%" height="26" fill="#000000" />
          <rect x="0" y="26" width="100%" height="24" fill="#0f172a" />
          <text id="category-title" x="14" y="45" text-length="28" font-size="18" fill="#60a5fa"></text>
          <rect y="50" width="100%" height="2" fill="#1f2937" />
        </g>
        <g id="task-group" display="none">
          <rect id="task-touch" x="0" y="0" width="100%" height="52" fill="#000000" pointer-events="visible" />
          <text id="task-title" x="14" y="36" text-length="24" font-size="28" fill="#ffffff" pointer-events="none"></text>
          <rect id="checkbox-border" x="258" y="12" width="28" height="28" rx="6" fill="#6b7280" pointer-events="none" />
          <rect id="checkbox-fill" x="260" y="14" width="24" height="24" rx="4" fill="#000000" pointer-events="none" />
          <g id="checkbox-check" display="none" pointer-events="none">
            <rect x="258" y="12" width="28" height="28" rx="6" fill="#22c55e" />
            <line x1="264" y1="26" x2="270" y2="33" stroke-width="3" fill="#ffffff" />
            <line x1="270" y1="33" x2="280" y2="20" stroke-width="3" fill="#ffffff" />
          </g>
          <rect id="tile-divider-bottom" y="50" width="100%" height="2" fill="#1f2937" pointer-events="none" />
        </g>
      </use>
    </symbol>

    <!-- Lists Row 0 (64px): top 28px clears status bar, bottom 36px has full-width Sync Lists button -->
    <symbol id="lists-sync-tile" height="64">
      <use id="lists-sync-tile-list" href="#tile-list-item" class="lists-list-tile" height="64" display="inline">
        <rect x="0" y="0" width="100%" height="64" fill="#000000" pointer-events="none" />
        <rect id="lists-sync-touch" x="12" y="30" width="276" height="32" rx="8" fill="#2563eb" pointer-events="visible" />
        <text id="lists-sync-label" x="150" y="52" text-anchor="middle" text-length="16" font-size="18" fill="#ffffff" pointer-events="none">Sync Lists</text>
      </use>
    </symbol>

    <!-- Large-font list picker tile (64px height, 28px name + 16px subtitle) -->
    <symbol id="list-item" height="64">
      <use id="list-tile-list" href="#tile-list-item" class="lists-list-tile" height="64" display="none">
        <rect id="list-touch" x="0" y="0" width="100%" height="64" fill="#000000" pointer-events="visible" />
        <text id="list-title" x="14" y="30" text-length="24" font-size="28" fill="#ffffff" pointer-events="none"></text>
        <text id="list-subtitle" x="14" y="54" text-length="28" font-size="16" fill="#60a5fa" pointer-events="none"></text>
        <rect id="list-divider-bottom" y="62" width="100%" height="2" fill="#1f2937" pointer-events="none" />
      </use>
    </symbol>
  </defs>

  <rect id="background" x="0" y="0" width="100%" height="100%" fill="#000000" />

  <!-- Native horizontal swipe container: Page 0 = Tasks, Page 1 = Lists (swipe from right) -->
  <use id="container" href="#panoramaview" x="0" y="0" width="100%" height="100%">
    <!-- Page 0 (top-level): Static #tile-list (no virtual="1" recycling bugs when scrolling back up) -->
    <use id="tasks-page" href="#panoramaview-item">
      <use id="checklist" href="#tile-list" x="0" y="0" width="100%" height="100%">
        <use id="top-spacer-row" href="#top-spacer" class="task-list-tile" />
        <use id="actions-row" href="#actions-tile" class="task-list-tile" />
        <use id="row-0" href="#list-row" class="task-list-tile" />
        <use id="row-1" href="#list-row" class="task-list-tile" />
        <use id="row-2" href="#list-row" class="task-list-tile" />
        <use id="row-3" href="#list-row" class="task-list-tile" />
        <use id="row-4" href="#list-row" class="task-list-tile" />
        <use id="row-5" href="#list-row" class="task-list-tile" />
        <use id="row-6" href="#list-row" class="task-list-tile" />
        <use id="row-7" href="#list-row" class="task-list-tile" />
        <use id="row-8" href="#list-row" class="task-list-tile" />
        <use id="row-9" href="#list-row" class="task-list-tile" />
        <use id="row-10" href="#list-row" class="task-list-tile" />
        <use id="row-11" href="#list-row" class="task-list-tile" />
        <use id="row-12" href="#list-row" class="task-list-tile" />
        <use id="row-13" href="#list-row" class="task-list-tile" />
        <use id="row-14" href="#list-row" class="task-list-tile" />
        <use id="row-15" href="#list-row" class="task-list-tile" />
        <use id="row-16" href="#list-row" class="task-list-tile" />
        <use id="row-17" href="#list-row" class="task-list-tile" />
        <use id="row-18" href="#list-row" class="task-list-tile" />
        <use id="row-19" href="#list-row" class="task-list-tile" />
        <use id="row-20" href="#list-row" class="task-list-tile" />
        <use id="row-21" href="#list-row" class="task-list-tile" />
        <use id="row-22" href="#list-row" class="task-list-tile" />
        <use id="row-23" href="#list-row" class="task-list-tile" />
        <use id="row-24" href="#list-row" class="task-list-tile" />
        <use id="row-25" href="#list-row" class="task-list-tile" />
        <use id="row-26" href="#list-row" class="task-list-tile" />
        <use id="row-27" href="#list-row" class="task-list-tile" />
        <use id="row-28" href="#list-row" class="task-list-tile" />
        <use id="row-29" href="#list-row" class="task-list-tile" />
        <use id="row-30" href="#list-row" class="task-list-tile" />
        <use id="row-31" href="#list-row" class="task-list-tile" />
        <use id="row-32" href="#list-row" class="task-list-tile" />
        <use id="row-33" href="#list-row" class="task-list-tile" />
        <use id="row-34" href="#list-row" class="task-list-tile" />
        <use id="row-35" href="#list-row" class="task-list-tile" />
        <use id="row-36" href="#list-row" class="task-list-tile" />
        <use id="row-37" href="#list-row" class="task-list-tile" />
        <use id="row-38" href="#list-row" class="task-list-tile" />
        <use id="row-39" href="#list-row" class="task-list-tile" />
        <use id="row-40" href="#list-row" class="task-list-tile" />
        <use id="row-41" href="#list-row" class="task-list-tile" />
        <use id="row-42" href="#list-row" class="task-list-tile" />
        <use id="row-43" href="#list-row" class="task-list-tile" />
        <use id="row-44" href="#list-row" class="task-list-tile" />
        <use id="row-45" href="#list-row" class="task-list-tile" />
        <use id="row-46" href="#list-row" class="task-list-tile" />
        <use id="row-47" href="#list-row" class="task-list-tile" />
        <use id="row-48" href="#list-row" class="task-list-tile" />
        <use id="row-49" href="#list-row" class="task-list-tile" />
        <use id="row-50" href="#list-row" class="task-list-tile" />
        <use id="row-51" href="#list-row" class="task-list-tile" />
        <use id="row-52" href="#list-row" class="task-list-tile" />
        <use id="row-53" href="#list-row" class="task-list-tile" />
        <use id="row-54" href="#list-row" class="task-list-tile" />
        <use id="row-55" href="#list-row" class="task-list-tile" />
        <use id="row-56" href="#list-row" class="task-list-tile" />
        <use id="row-57" href="#list-row" class="task-list-tile" />
        <use id="row-58" href="#list-row" class="task-list-tile" />
        <use id="row-59" href="#list-row" class="task-list-tile" />
      </use>
    </use>

    <!-- Page 1 (swipe from right): Available VTODO task lists picker (static #tile-list) -->
    <use id="lists-page" href="#panoramaview-item">
      <use id="lists-checklist" href="#tile-list" x="0" y="0" width="100%" height="100%">
        <use id="lists-sync-row" href="#lists-sync-tile" class="lists-list-tile" />
        <use id="list-item-0" href="#list-item" class="lists-list-tile" />
        <use id="list-item-1" href="#list-item" class="lists-list-tile" />
        <use id="list-item-2" href="#list-item" class="lists-list-tile" />
        <use id="list-item-3" href="#list-item" class="lists-list-tile" />
        <use id="list-item-4" href="#list-item" class="lists-list-tile" />
        <use id="list-item-5" href="#list-item" class="lists-list-tile" />
        <use id="list-item-6" href="#list-item" class="lists-list-tile" />
        <use id="list-item-7" href="#list-item" class="lists-list-tile" />
        <use id="list-item-8" href="#list-item" class="lists-list-tile" />
        <use id="list-item-9" href="#list-item" class="lists-list-tile" />
        <use id="list-item-10" href="#list-item" class="lists-list-tile" />
        <use id="list-item-11" href="#list-item" class="lists-list-tile" />
        <use id="list-item-12" href="#list-item" class="lists-list-tile" />
        <use id="list-item-13" href="#list-item" class="lists-list-tile" />
        <use id="list-item-14" href="#list-item" class="lists-list-tile" />
        <use id="list-item-15" href="#list-item" class="lists-list-tile" />
      </use>
    </use>
  </use>

  <!-- Slim 28px status bar declared AFTER panorama so it always paints cleanly on top -->
  <rect id="header-bg" x="0" y="0" width="100%" height="26" fill="#111827" />
  <text id="status" x="12" y="19" text-length="28" font-size="16" fill="#e5e7eb">Loading...</text>
  <text id="page-hint" x="288" y="19" text-anchor="end" text-length="10" font-size="14" fill="#60a5fa">Lists ›</text>
  <rect id="header-divider" x="0" y="26" width="100%" height="2" fill="#1f2937" />
</svg>
